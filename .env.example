# Production Docker Compose settings. HTTP until TLS certificates are installed.
MONGODB_URI=
JWT_SECRET=
FRONTEND_URL=http://ogk-gym-tracker.koreacentral.cloudapp.azure.com
# Same-origin URL works with both HTTP and future HTTPS.
VITE_API_URL=/backend/api

# Set only after certificates exist (deploy/enable-https.sh does this).
# NGINX_CONFIG=./nginx/https.conf
